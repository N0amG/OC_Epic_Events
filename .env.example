# Mot de passe du super utilisateur PostgreSQL (si nécessaire pour la création de la base)
PostgreUserPassword=votre_mot_de_passe_postgres_admin

# Configuration Base de données PostgreSQL
DB_USER=votre_utilisateur_postgres
DB_PASSWORD=votre_mot_de_passe
DB_HOST=localhost
DB_PORT=5432
DB_NAME=epicevents

# URL complète de la base de données (alternative à la configuration séparée)
DATABASE_URL=postgresql://username:password@localhost:5432/epicevents

# Clé secrète pour JWT (générez-en une aléatoire forte)
# Exemple de génération : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=votre_cle_secrete_jwt_aleatoire

# Configuration Sentry (optionnel)
# Créez un compte sur sentry.io et récupérez votre DSN
# Laisser vide pour désactiver Sentry
SENTRY_DSN=

# Environnement (development, staging, production)
ENVIRONMENT=development
